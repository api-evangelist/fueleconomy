          "name": "Get vehicle models for a year and make",
          "request": {
            "name": "Get vehicle models for a year and make",
            "description": {
              "content": "Returns a list of all vehicle models available for the specified model year and manufacturer. Use the returned model values as input to the options menu endpoint to retrieve vehicle IDs.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "vehicle",
                "menu",
                "model"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "year",
                  "value": "<integer>",
                  "description": "(Required) Four-digit model year (e.g., 2024). Valid range is 1984 through current+1."
                },
                {
                  "disabled": false,
                  "key": "make",
                  "value": "<string>",
                  "description": "(Required) Vehicle manufacturer name (e.g., Toyota, Ford). Must match a value from the make menu."
