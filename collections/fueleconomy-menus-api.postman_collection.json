        {
          "id": "282a39b1-f271-4af0-93dd-74c0bf964e86",
          "name": "Get vehicle options with IDs for a year, make, and model",
          "request": {
            "name": "Get vehicle options with IDs for a year, make, and model",
            "description": {
              "content": "Returns a list of vehicle trim and configuration options for the specified year, make, and model. Each menu item includes the vehicle ID (value) needed to retrieve full EPA fuel economy records via the /vehicle/{id} endpoint.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "vehicle",
                "menu",
                "options"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "year",
                  "value": "<integer>",
                  "description": "(Required) Four-digit model year (e.g., 2024). Valid range is 1984 through current+1."
                },
                {
                  "disabled": false,
                  "key": "make",
                  "value": "<string>",
                  "description": "(Required) Vehicle manufacturer name (e.g., Toyota, Ford). Must match a value from the make menu."
                },
                {
                  "disabled": false,
                  "key": "model",
                  "value": "<string>",
                  "description": "(Required) Vehicle model name (e.g., Camry LE/SE). Must match a value from the model menu."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/xml"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "6a89af84-bfcb-46f3-b547-6164cb71d91d",
