        {
          "id": "c4465643-e0e6-4416-afd4-3befd2d626ed",
          "name": "Get makes with community MPG data",
          "request": {
            "name": "Get makes with community MPG data",
            "description": {
              "content": "Returns a list of vehicle makes for which community-contributed real-world MPG data exists. Spans historical makes including discontinued brands. Use the returned make values with the /ympg/shared/menu/model endpoint.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "ympg",
                "shared",
                "menu",
                "make"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/xml"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
