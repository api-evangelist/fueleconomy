          "name": "Get vehicle emissions by ID",
          "request": {
            "name": "Get vehicle emissions by ID",
            "description": {
              "content": "Returns EPA tailpipe emissions certification records for a specific vehicle. Includes emissions family identifier, applicable sales area, emissions standard bin text, and SmartWay and air quality scores. A vehicle may have multiple emissions records for different sales territories.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "vehicle",
                "emissions",
                ":id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "id",
                  "description": "(Required) Unique numeric vehicle identifier assigned by the EPA/FuelEconomy.gov. Obtain IDs via the /vehicle/menu/options endpoint."
                }
              ]
            },
            "header": [
