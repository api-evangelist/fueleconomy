          "request": {
            "name": "Get vehicle by ID",
            "description": {
              "content": "Returns full EPA fuel economy record for a specific vehicle including city, highway, and combined MPG ratings, CO2 tailpipe emissions, annual fuel cost estimates, engine specifications, transmission, drive type, vehicle class, and SmartWay scores.",
              "type": "text/plain"
            },
            "url": {
